rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }
    function canManage() {
      return isSignedIn() && (myRole() == 'admin' || myRole() == 'coach');
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || canManage());
      allow delete: if isAdmin();
    }

    match /players/{playerId} {
      allow read: if isSignedIn();
      allow write: if canManage() || (isSignedIn() && resource.data.linkedUserId == request.auth.uid);
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
