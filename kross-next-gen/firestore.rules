rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return isSignedIn() && myRole() == 'admin';
    }
    function canManage() {
      return isSignedIn() && (myRole() == 'admin' || myRole() == 'coach');
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || canManage());
      allow delete: if isAdmin();
    }

    match /players/{playerId} {
      // Public so guests can browse players without logging in.
      allow read: if true;
      allow write: if canManage() || (isSignedIn() && resource.data.linkedUserId == request.auth.uid);

      // One doc per comment so each can be tied to its author. Anyone signed
      // in may post as themselves; only the author or a coach/admin may delete.
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.keys().hasOnly(['authorId', 'author', 'text', 'date', 'parentId', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.parentId is string
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/players/$(playerId));
        allow delete: if isSignedIn()
          && (resource.data.authorId == request.auth.uid || canManage());
      }
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
